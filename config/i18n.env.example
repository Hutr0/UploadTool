#
# UploadTool language configuration
#
# This file controls the language of the interactive wizards (run.sh, init.sh, etc).
# It is safe to keep this file in the same place as env.json / release.env / wizard.env.
#
# Supported values:
#   en - English (default)
#   ru - Russian
#
# You can also override language via environment variable:
#   UPLOADTOOL_LANG=en
#

UPLOADTOOL_LANG=en

