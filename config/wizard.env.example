## Release wizard behavior settings (used by run.sh).
## Recommended path (gitignored): <flutter_project>/.uploadtool/wizard.env
## This file is optional: built-in defaults are used when it is absent.

# ----------------------------------------------------------------------------
# Defaults for interactive questions
# ----------------------------------------------------------------------------
# Build targets: ios | android | both
# WIZARD_DEFAULT_TARGETS="both"

# Environment: dev | prod | both
# WIZARD_DEFAULT_ENV="both"

# Wait for TestFlight processing after upload? 0 = no, 1 = yes
# WIZARD_DEFAULT_WAIT_IOS="1"

# Upload to stores by default (when not skipping the question): 0 = no, 1 = yes
# WIZARD_DEFAULT_UPLOAD_IOS="1"
# WIZARD_DEFAULT_UPLOAD_ANDROID="1"

# In dev+prod mode, force Android uploads to be sequential to avoid
# Google Play "This Edit has been deleted" conflicts:
# 0 = allow parallel, 1 = force sequential (recommended)
# WIZARD_FORCE_SEQUENTIAL_ANDROID_UPLOAD="1"

# ----------------------------------------------------------------------------
# Skip steps: skip prompts and immediately use defaults
# ----------------------------------------------------------------------------
# 0 = ask (default), 1 = skip prompt and use WIZARD_DEFAULT_*
# Useful for CI or when every release follows the same scenario.

# Skip "What should we build?" and use WIZARD_DEFAULT_TARGETS
# WIZARD_SKIP_TARGETS="0"

# Skip "Environment (dev/prod/both)?" and use WIZARD_DEFAULT_ENV
# WIZARD_SKIP_ENV="0"

# Skip "Upload iOS/Android to store?" and use WIZARD_DEFAULT_UPLOAD_*
# WIZARD_SKIP_UPLOAD_PROMPTS="0"

# Skip "Wait for TestFlight processing?" and use WIZARD_DEFAULT_WAIT_IOS
# WIZARD_SKIP_WAIT_IOS_PROMPT="0"

# Skip the final "Go ahead?" confirmation
# WIZARD_SKIP_FINAL_CONFIRM="0"
