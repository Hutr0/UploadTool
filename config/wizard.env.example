## Настройки поведения мастера релизов (скрипт run.sh).
## Рекомендуемый путь (в gitignore): <flutter_project>/.uploadtool/wizard.env
## Файл опционален: если его нет, используются встроенные значения по умолчанию.

# ------------------------------------------------------------------------------
# Значения по умолчанию для интерактивных вопросов
# ------------------------------------------------------------------------------
# Куда собирать: ios | android | both
# WIZARD_DEFAULT_TARGETS="both"

# Окружение: dev | prod | both
# WIZARD_DEFAULT_ENV="both"

# Ждать обработку билда в TestFlight после загрузки? 0 = нет, 1 = да
# WIZARD_DEFAULT_WAIT_IOS="1"

# По умолчанию загружать в сторы (если не пропускаем вопрос): 0 = нет, 1 = да
# WIZARD_DEFAULT_UPLOAD_IOS="1"
# WIZARD_DEFAULT_UPLOAD_ANDROID="1"

# ------------------------------------------------------------------------------
# Пропуск шагов: не спрашивать, сразу взять значение по умолчанию
# ------------------------------------------------------------------------------
# 0 = спрашивать (по умолчанию), 1 = не спрашивать, взять WIZARD_DEFAULT_*
# Полезно для CI или когда всегда собираешь одно и то же.

# Не спрашивать «Куда собираем?», использовать WIZARD_DEFAULT_TARGETS
# WIZARD_SKIP_TARGETS="0"

# Не спрашивать «Окружение (dev/prod/both)?», использовать WIZARD_DEFAULT_ENV
# WIZARD_SKIP_ENV="0"

# Не спрашивать «Загрузить iOS/Android в store?», использовать WIZARD_DEFAULT_UPLOAD_*
# WIZARD_SKIP_UPLOAD_PROMPTS="0"

# Не спрашивать «Ждать обработку в TestFlight?», использовать WIZARD_DEFAULT_WAIT_IOS
# WIZARD_SKIP_WAIT_IOS_PROMPT="0"

# Не спрашивать «Поехали?» в конце, сразу запускать
# WIZARD_SKIP_FINAL_CONFIRM="0"
