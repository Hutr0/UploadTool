## Единственный конфиг для сборки и публикации (iOS + Android).
## Рекомендуемый путь (в gitignore): <flutter_project>/.uploadtool/release.env
## Запуск (если UploadTool внутри проекта): ./Upload или ./UploadTool/run.sh
## Запуск (если UploadTool отдельно): bash /path/to/UploadTool/run.sh --project-root <flutter_project> --config-dir <flutter_project>/.uploadtool
## Документация: UploadTool/docs/release_wizard.md

# ------------------------------------------------------------------------------
# Куда собирать (по умолчанию спрашивает в мастере; можно задать заранее)
# ------------------------------------------------------------------------------
# ios | android | both
# RELEASE_TARGETS="both"

# ------------------------------------------------------------------------------
# Версия сборки (по умолчанию берётся из pubspec.yaml)
# ------------------------------------------------------------------------------
# BUILD_NAME="3.8.3"
# BUILD_NUMBER="20260220.4"     # ядро (для dev+prod станет 20260220.4.0 и 20260220.5.1)
# BUILD_NUMBER="20260220.4.1"  # полный номер (X: dev=0, prod=1)

# ------------------------------------------------------------------------------
# Идентичность приложения (нужно для портативного использования UploadTool)
# ------------------------------------------------------------------------------
# iOS bundle id
# IOS_APP_IDENTIFIER="lifestyle.shopping.choys"

# iOS Team ID (если не задан, может использоваться FASTLANE_TEAM_ID)
# IOS_TEAM_ID="LSBS69V2G7"

# Android applicationId
# ANDROID_PACKAGE_NAME="lifestyle.shopping.choys"

# ------------------------------------------------------------------------------
# iOS TestFlight — заметки и ожидание обработки
# ------------------------------------------------------------------------------
# TESTFLIGHT_CHANGELOG="Bug fixes and improvements"
# WAIT_FOR_BUILD_PROCESSING="0"   # 0 = не ждать, 1 = ждать (по умолчанию в мастере можно задать в wizard.env)

# ------------------------------------------------------------------------------
# iOS TestFlight — авторизация (выбери ОДИН способ)
# ------------------------------------------------------------------------------
# Вариант A (рекомендуется): App Store Connect API Key
# App Store Connect → Users and Access → Integrations → Keys → создать ключ.
# ASC_KEY_ID="YOUR_KEY_ID"
# ASC_ISSUER_ID="YOUR_ISSUER_ID"
# ASC_KEY_PATH="$HOME/keys/AuthKey_YOUR_KEY_ID.p8"

# Вариант B: Apple ID + app-specific password (без API-ключа)
# FASTLANE_USER="you@example.com"
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Если в App Store Connect несколько команд — укажи нужную:
# FASTLANE_TEAM_ID="123456789"
# FASTLANE_TEAM_NAME="Your Team Name"
# (поддерживаются и старые имена)
# FASTLANE_ITC_TEAM_ID="123456789"
# FASTLANE_ITC_TEAM_NAME="Your Team Name"

# ------------------------------------------------------------------------------
# Android Google Play
# ------------------------------------------------------------------------------
# Путь к JSON ключу сервисного аккаунта (нужны права на загрузку в Play Console).
# PLAY_JSON_KEY_PATH="$HOME/keys/google-play-service-account.json"

# Трек: internal | alpha | beta | production
# PLAY_TRACK="internal"

# Статус релиза: completed | draft | halted | inProgress
# PLAY_RELEASE_STATUS="completed"

# Заметки релиза (опционально; иначе из мастера)
# PLAY_RELEASE_NOTES="Bug fixes and improvements"
# PLAY_LOCALE="en-US"

# Ручная переопределение versionCode (опционально; обычно считается из BUILD_NUMBER)
# ANDROID_BUILD_NUMBER="2026022101"
