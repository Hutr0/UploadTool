## Single configuration file for build and upload (iOS + Android).
## Recommended location (gitignored): <flutter_project>/.uploadtool/release.env
## Run (UploadTool inside the project): ./Upload or ./UploadTool/run.sh
## Run (from UploadTool repo itself): ./run.sh
## Run (UploadTool elsewhere): bash /path/to/UploadTool/run.sh --project-root <flutter_project> --config-dir <flutter_project>/.uploadtool
## Documentation (inside UploadTool repo): docs/release_wizard.md

# ------------------------------------------------------------------------------
# Build targets (wizard asks by default; can be preset here)
# ------------------------------------------------------------------------------
# ios | android | both
# RELEASE_TARGETS="both"

# ------------------------------------------------------------------------------
# Build version (defaults come from pubspec.yaml)
# ------------------------------------------------------------------------------
# BUILD_NAME="3.8.3"
# BUILD_NUMBER="20260220.4"     # core value (dev+prod => 20260220.4.0 and 20260220.5.1)
# BUILD_NUMBER="20260220.4.1"  # full number (X: dev=0, prod=1)

# ------------------------------------------------------------------------------
# App identity (useful when UploadTool is reused across projects)
# ------------------------------------------------------------------------------
# iOS bundle id
# IOS_APP_IDENTIFIER="com.example.app"

# iOS Team ID (if omitted, FASTLANE_TEAM_ID may be used)
# IOS_TEAM_ID="YOUR_TEAM_ID"

# Android applicationId
# ANDROID_PACKAGE_NAME="com.example.app"

# ------------------------------------------------------------------------------
# iOS TestFlight — release notes and processing wait
# ------------------------------------------------------------------------------
# TESTFLIGHT_CHANGELOG="Bug fixes and improvements"
# WAIT_FOR_BUILD_PROCESSING="0"   # 0 = do not wait, 1 = wait (wizard defaults via wizard.env)

# ------------------------------------------------------------------------------
# iOS TestFlight — authentication (choose ONE option)
# ------------------------------------------------------------------------------
# Option A (recommended): App Store Connect API Key
# App Store Connect → Users and Access → Integrations → Keys → create key.
# ASC_KEY_ID="YOUR_KEY_ID"
# ASC_ISSUER_ID="YOUR_ISSUER_ID"
# ASC_KEY_PATH="$HOME/keys/AuthKey_YOUR_KEY_ID.p8"

# Option B: Apple ID + app-specific password (no API key)
# FASTLANE_USER="you@example.com"
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# When multiple App Store Connect teams exist — specify:
# FASTLANE_TEAM_ID="123456789"
# FASTLANE_TEAM_NAME="Your Team Name"
# (legacy names still supported)
# FASTLANE_ITC_TEAM_ID="123456789"
# FASTLANE_ITC_TEAM_NAME="Your Team Name"

# ------------------------------------------------------------------------------
# Android Google Play
# ------------------------------------------------------------------------------
# Path to the service account JSON key (must have upload permissions in Play Console).
# PLAY_JSON_KEY_PATH="$HOME/keys/google-play-service-account.json"

# Track: internal | alpha | beta | production
# PLAY_TRACK="internal"

# Release status: completed | draft | halted | inProgress
# PLAY_RELEASE_STATUS="completed"

# Release notes (optional; otherwise taken from the wizard)
# PLAY_RELEASE_NOTES="Bug fixes and improvements"
# PLAY_LOCALE="ru-RU"

# Manual versionCode override (optional; normally derived from BUILD_NUMBER)
# ANDROID_BUILD_NUMBER="2026022101"
